                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image"
                          ]
                        },
                        "src": {
                          "type": "string",
                          "description": "An https URL, a data: URI, or a path relative to the deck JSON file. The compiler inlines local files."
                        },
                        "alt": {
                          "type": "string",
                          "description": "Required alternative text.",
                          "title": "minLength(1)",
                          "minLength": 1
                        },
                        "caption": {
                          "type": "string",
