{
  "module-code": "eque2-code",
  "parent-agent": "linus",
  "workflow-name": "create-spec",
  "menu-code": "CS",
  "description": "Produces a validated, executable build spec — context, coverage, scenarios, tasks, and a definitions.json — gated by cs-generate-definitions.py and the state CLI's init verb decode.",
  "supports-headless": true,
  "phase-name": "2-spec",
  "after": ["jira-fetch"],
  "before": [],
  "is-required": true,
  "output-location": "{feature_artifacts}",
  "output-contract": {
    "frozen": true,
    "depended-on-by": ["execute-verify", "build-task", "review-task"],
    "structure": {
      "root": "{feature_artifacts}/{FEATURE-ID}/",
      "required-files": [
        "spec.md",
        "context.md",
        "coverage.md",
        "scenarios.gherkin",
        "tasks.md",
        "definitions.json"
      ],
      "required-folders": [],
      "validation-gate": "uv run scripts/cs-generate-definitions.py {feature_artifacts}/{FEATURE-ID} --test-dir-from-context"
    },
    "frontmatter-contract": {
      "spec.md": {
        "required-fields": [
          "title",
          "specSlug",
          "stepsCompleted",
          "coverage_validated",
          "edge_cases_researched",
          "status"
        ],
        "terminal-status": "ready-for-build"
      }
    }
  },
  "auto-invocations": [
    {
      "stage": 6,
      "skill": "bmad-party-mode",
      "purpose": "Multi-agent perspective check on spec content (context+coverage+scenarios). Findings auto-applied.",
      "suppressed-by": ["--no-party", "--yolo", "--interactive"]
    },
    {
      "stage": 7,
      "skill": "bmad-review",
      "purpose": "Method-driven branch/boundary walk over tasks+scenarios. Findings auto-applied.",
      "suppressed-by": ["--no-edge-cases", "--yolo", "--interactive"]
    },
    {
      "stage": 8,
      "skill": "bmad-review",
      "purpose": "Cynical/red-team review of full spec. Findings auto-applied (critical + enhancement).",
      "suppressed-by": ["--no-adversarial", "--yolo", "--interactive"]
    },
    {
      "stage": 8,
      "skill": "checklist.md",
      "purpose": "Fresh-context Ready-for-Build validator. Findings auto-applied.",
      "suppressed-by": ["--no-checklist", "--yolo", "--interactive"]
    }
  ],
  "ready-for-build-criteria": [
    "Scenarios First",
    "Tasks Support Scenarios",
    "Testable",
    "Actionable",
    "Logical (dependency-ordered)",
    "Complete (no TBD / placeholders)",
    "Self-Contained",
    "Verifiable (cs-generate-definitions.py status: ok)"
  ]
}
