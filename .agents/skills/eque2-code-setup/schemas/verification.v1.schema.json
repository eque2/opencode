{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "metadata",
    "tasks",
    "scenarios",
    "execution_log"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "spec_slug",
        "spec_file",
        "created",
        "max_retries_per_task",
        "max_retries_per_scenario"
      ],
      "properties": {
        "spec_slug": {
          "type": "string"
        },
        "spec_file": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "max_retries_per_task": {
          "type": "number"
        },
        "max_retries_per_scenario": {
          "type": "number"
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "autonomous",
            "supervised",
            "assisted"
          ]
        },
        "worktree_path": {
          "type": "string"
        },
        "parent_cwd": {
          "type": "string"
        },
        "environment_created": {
          "type": "string"
        },
        "remediation": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxAttempts": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "depends_on",
          "supports_scenarios",
          "status",
          "blocker_category",
          "risk_level",
          "risk_reasons",
          "attempts",
          "evidence",
          "evidence_trusted",
          "completed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supports_scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "complete",
              "blocked",
              "failed"
            ]
          },
          "blocker_category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "config",
                  "code",
                  "environment",
                  "external"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "risk_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "number",
                "timestamp",
                "approach",
                "result",
                "notes"
              ],
              "properties": {
                "number": {
                  "type": "number"
                },
                "timestamp": {
                  "type": "string"
                },
                "approach": {
                  "type": "string"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "success",
                    "failure",
                    "partial"
                  ]
                },
                "error": {
                  "type": "string"
                },
                "error_signature": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "duration_ms": {
                  "type": "number"
                },
                "cost_usd": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "artifact",
                "checksum",
                "verified",
                "verification_notes"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "test",
                    "git",
                    "file",
                    "screenshot",
                    "log"
                  ]
                },
                "artifact": {
                  "type": "string"
                },
                "checksum": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "verification_notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence_trusted": {
            "type": "boolean"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "type": "object",
            "required": [
              "completed_at",
              "issues_found",
              "issues_fixed",
              "commit_sha",
              "remaining_issues"
            ],
            "properties": {
              "completed_at": {
                "type": "string"
              },
              "issues_found": {
                "type": "number"
              },
              "issues_fixed": {
                "type": "number"
              },
              "commit_sha": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "remaining_issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "severity",
                    "file",
                    "issue"
                  ],
                  "properties": {
                    "severity": {
                      "type": "string",
                      "enum": [
                        "HIGH",
                        "MEDIUM",
                        "LOW"
                      ]
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": "number"
                    },
                    "issue": {
                      "type": "string"
                    },
                    "reason_not_fixed": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "epic_review": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "gherkin_ref",
          "status",
          "depends_on_tasks",
          "attempts",
          "evidence",
          "evidence_trusted",
          "completed_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gherkin_ref": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "executing",
              "evaluating",
              "remediating",
              "needsHuman",
              "cascading",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "depends_on_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "number",
                "timestamp",
                "test_file",
                "result"
              ],
              "properties": {
                "number": {
                  "type": "number"
                },
                "timestamp": {
                  "type": "string"
                },
                "test_file": {
                  "type": "string"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "success",
                    "failure"
                  ]
                },
                "error": {
                  "type": "string"
                },
                "duration_ms": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "artifact",
                "checksum",
                "verified",
                "verification_notes"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "test",
                    "git",
                    "file",
                    "screenshot",
                    "log"
                  ]
                },
                "artifact": {
                  "type": "string"
                },
                "checksum": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "verification_notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence_trusted": {
            "type": "boolean"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "execution_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "event_type",
          "task_id",
          "details"
        ],
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "task_start",
              "task_complete",
              "task_fail",
              "blocker",
              "human_touchpoint",
              "checkpoint",
              "preflight",
              "scenario_start",
              "scenario_pass",
              "scenario_fail",
              "phase_change",
              "review_start",
              "review_complete"
            ]
          },
          "task_id": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
