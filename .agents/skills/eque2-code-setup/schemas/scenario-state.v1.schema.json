{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "metadata",
    "scenarios",
    "build_scenarios",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "spec_slug",
        "created",
        "max_retries_per_scenario",
        "e2e_test_dir"
      ],
      "properties": {
        "spec_slug": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "max_retries_per_scenario": {
          "type": "number"
        },
        "e2e_test_dir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "gherkin_ref",
          "depends_on_tasks",
          "status",
          "e2e_test_file",
          "evidence",
          "attempts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gherkin_ref": {
            "type": "string"
          },
          "depends_on_tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "executing",
              "evaluating",
              "remediating",
              "needsHuman",
              "cascading",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "e2e_test_file": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "required": [
              "test_passed",
              "screenshot",
              "trace",
              "completed_at"
            ],
            "properties": {
              "test_passed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "screenshot": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trace": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completed_at": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trust_level": {
                "type": "string",
                "enum": [
                  "untrusted",
                  "pending_review",
                  "verified",
                  "trusted",
                  "suspect"
                ]
              },
              "trust_updated_at": {
                "type": "string"
              },
              "trust_reason": {
                "type": "string"
              },
              "verification_method": {
                "type": "string",
                "enum": [
                  "automated",
                  "semantic_ai",
                  "human_review"
                ]
              }
            },
            "additionalProperties": false
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attempt",
                "started_at",
                "completed_at",
                "result"
              ],
              "properties": {
                "attempt": {
                  "type": "number"
                },
                "started_at": {
                  "type": "string"
                },
                "completed_at": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed"
                  ]
                },
                "error": {
                  "type": "string"
                },
                "duration_ms": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "build_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "command",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "executing",
              "evaluating",
              "remediating",
              "needsHuman",
              "cascading",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "output",
              "exit_code",
              "completed_at"
            ],
            "properties": {
              "output": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exit_code": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completed_at": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_scenarios",
        "total_build",
        "scenarios_pending",
        "scenarios_passed",
        "scenarios_failed",
        "build_pending",
        "build_passed",
        "build_failed"
      ],
      "properties": {
        "total_scenarios": {
          "type": "number"
        },
        "total_build": {
          "type": "number"
        },
        "scenarios_pending": {
          "type": "number"
        },
        "scenarios_passed": {
          "type": "number"
        },
        "scenarios_failed": {
          "type": "number"
        },
        "build_pending": {
          "type": "number"
        },
        "build_passed": {
          "type": "number"
        },
        "build_failed": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
