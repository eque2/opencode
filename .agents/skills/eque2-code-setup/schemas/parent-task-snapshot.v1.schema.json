{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "value",
    "context",
    "status",
    "tags"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pending_review",
            "reviewing",
            "verifyingSubtasks",
            "verified",
            "failed"
          ]
        },
        {
          "type": "object",
          "required": [
            "buildingSubtasks"
          ],
          "properties": {
            "buildingSubtasks": {
              "type": "string",
              "enum": [
                "checkingProgress",
                "executingSubtask"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "taskId",
        "description",
        "worktreePath",
        "reviewResult",
        "attemptNumber",
        "maxAttempts"
      ],
      "properties": {
        "taskId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "worktreePath": {
          "type": "string"
        },
        "subtaskSnapshots": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {
            "$id": "/schemas/unknown",
            "title": "unknown"
          }
        },
        "subtaskActors": {
          "type": "object",
          "required": [],
          "properties": {},
          "additionalProperties": {
            "$id": "/schemas/unknown",
            "title": "unknown"
          }
        },
        "reviewResult": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "passed",
                "findings"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "severity",
                      "type",
                      "message",
                      "file",
                      "line",
                      "suggestion"
                    ],
                    "properties": {
                      "severity": {
                        "type": "string",
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low"
                        ]
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "security",
                          "pattern",
                          "quality"
                        ]
                      },
                      "message": {
                        "type": "string"
                      },
                      "file": {
                        "type": "string"
                      },
                      "line": {
                        "type": "number"
                      },
                      "suggestion": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptNumber": {
          "type": "number"
        },
        "maxAttempts": {
          "type": "number"
        },
        "evidence": {
          "type": "object",
          "required": [],
          "properties": {
            "trustLevel": {
              "type": "string",
              "enum": [
                "untrusted",
                "pending_review",
                "verified",
                "trusted",
                "suspect"
              ]
            },
            "trustUpdatedAt": {
              "type": "string"
            },
            "trustReason": {
              "type": "string"
            },
            "verificationMethod": {
              "type": "string",
              "enum": [
                "automated",
                "semantic_ai",
                "human_review"
              ]
            },
            "invalidatedBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "done",
        "error",
        "stopped"
      ]
    },
    "tags": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "$id": "/schemas/unknown",
        "title": "unknown"
      }
    },
    "_integrity": {
      "type": "string"
    },
    "_machineVersion": {
      "type": "string"
    },
    "_schemaVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
