{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "metadata",
    "tasks",
    "summary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": [
        "spec_slug",
        "created",
        "max_retries_per_task"
      ],
      "properties": {
        "spec_slug": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "max_retries_per_task": {
          "type": "number"
        },
        "worktree_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "phase",
          "depends_on",
          "supports_scenarios",
          "status",
          "tests",
          "evidence",
          "attempts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "type": "number"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supports_scenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "failed",
              "blocked"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "pattern"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "tests_passed",
              "test_output",
              "commit_sha",
              "completed_at"
            ],
            "properties": {
              "tests_passed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "test_output": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit_sha": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completed_at": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trust_level": {
                "type": "string",
                "enum": [
                  "untrusted",
                  "pending_review",
                  "verified",
                  "trusted",
                  "suspect"
                ]
              },
              "trust_updated_at": {
                "type": "string"
              },
              "trust_reason": {
                "type": "string"
              },
              "invalidated_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attemptNumber",
                "timestamp",
                "approach",
                "result",
                "notes",
                "durationMs"
              ],
              "properties": {
                "attemptNumber": {
                  "type": "number"
                },
                "timestamp": {
                  "type": "string"
                },
                "approach": {
                  "type": "string"
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "success",
                    "failure"
                  ]
                },
                "error": {
                  "type": "string"
                },
                "errorSignature": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "pending",
        "in_progress",
        "completed",
        "failed",
        "blocked"
      ],
      "properties": {
        "total": {
          "type": "number"
        },
        "pending": {
          "type": "number"
        },
        "in_progress": {
          "type": "number"
        },
        "completed": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "blocked": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
