{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "checkId",
    "checkType",
    "createdAt",
    "status",
    "reason",
    "originalCommand",
    "transcripts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "checkId": {
      "type": "string"
    },
    "checkType": {
      "type": "string",
      "enum": [
        "build",
        "scenario"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "COMMAND_INVALID",
        "UNFIXABLE"
      ]
    },
    "originalCommand": {
      "type": "string"
    },
    "suggestion": {
      "type": "string"
    },
    "transcripts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "type": "object",
      "required": [
        "type",
        "resolvedAt"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMMAND_UPDATED",
            "SKIP"
          ]
        },
        "newCommand": {
          "type": "string"
        },
        "resolvedAt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
