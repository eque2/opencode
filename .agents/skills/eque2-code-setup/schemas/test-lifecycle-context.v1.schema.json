{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "testId",
    "folderPath",
    "complianceAttempts",
    "runAttempts",
    "rejectedClaimCount",
    "preClaimState",
    "verifyingStartedAt",
    "verifyingClaimType",
    "failureReason",
    "lastRunId",
    "machineVersion"
  ],
  "properties": {
    "testId": {
      "type": "string"
    },
    "folderPath": {
      "type": "string"
    },
    "complianceAttempts": {
      "type": "number"
    },
    "runAttempts": {
      "type": "number"
    },
    "rejectedClaimCount": {
      "type": "number"
    },
    "preClaimState": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifyingStartedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifyingClaimType": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "COMPLY_PASS",
            "RUN_PASS",
            "BUILD_COMPLETE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failureReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastRunId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "machineVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
