{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "$schema",
    "specSlug",
    "createdAt",
    "parentTasks",
    "tasks",
    "scenarios",
    "buildChecks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "schemas/actor-definitions@1"
      ]
    },
    "specSlug": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "parentTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "phase",
          "workingDirectory",
          "dependsOn",
          "supportsScenarios",
          "tests"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supportsScenarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "pattern": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "testFile",
          "workingDirectory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string matching the pattern ^[A-Z]+-?\\d+(?:-[A-Z]+)*(?:\\.\\d+)?[a-z]?$",
            "pattern": "^[A-Z]+-?\\d+(?:-[A-Z]+)*(?:\\.\\d+)?[a-z]?$"
          },
          "description": {
            "type": "string"
          },
          "gherkin": {
            "type": "string"
          },
          "testFile": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "buildChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "command",
          "workingDirectory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "a string matching the pattern ^[A-Z]+-?\\d+(?:-[A-Z]+)*(?:\\.\\d+)?[a-z]?$",
            "pattern": "^[A-Z]+-?\\d+(?:-[A-Z]+)*(?:\\.\\d+)?[a-z]?$"
          },
          "description": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "workingDirectory": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
