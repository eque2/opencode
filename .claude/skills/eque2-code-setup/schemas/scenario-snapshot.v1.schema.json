{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "value",
    "context",
    "status",
    "tags"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "value": {
      "type": "string",
      "enum": [
        "not_started",
        "executing",
        "evaluating",
        "completed",
        "failed",
        "cascading",
        "remediating",
        "needsHuman",
        "skipped"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "scenarioId",
        "description",
        "testFile",
        "workingDirectory",
        "specFolder",
        "dependencies",
        "retryCount",
        "maxRetries"
      ],
      "properties": {
        "scenarioId": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "gherkin": {
          "type": "string"
        },
        "testFile": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
        },
        "specFolder": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "number"
        },
        "headless": {
          "type": "boolean"
        },
        "retryCount": {
          "type": "number"
        },
        "maxRetries": {
          "type": "number"
        },
        "remediationEnabled": {
          "type": "boolean"
        },
        "remediationAttempt": {
          "type": "number"
        },
        "maxRemediationAttempts": {
          "type": "number"
        },
        "transcriptDir": {
          "type": "string"
        },
        "exitCode": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "object",
          "required": [],
          "properties": {
            "trustLevel": {
              "type": "string",
              "enum": [
                "untrusted",
                "pending_review",
                "verified",
                "trusted",
                "suspect"
              ]
            },
            "trustUpdatedAt": {
              "type": "string"
            },
            "trustReason": {
              "type": "string"
            },
            "verificationMethod": {
              "type": "string",
              "enum": [
                "automated",
                "semantic_ai",
                "human_review"
              ]
            },
            "invalidatedBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "trustRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "done",
        "error",
        "stopped"
      ]
    },
    "tags": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": {
        "$id": "/schemas/unknown",
        "title": "unknown"
      }
    },
    "_integrity": {
      "type": "string"
    },
    "_machineVersion": {
      "type": "string"
    },
    "_schemaVersion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
