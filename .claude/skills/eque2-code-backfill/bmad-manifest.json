{
  "module-code": "eque2-code",
  "parent-agent": "grace",
  "workflow-name": "backfill",
  "menu-code": "BK",
  "description": "Batch-backfill automated Playwright tests for an Xray folder — seed the lifecycle server, fan out parallel subagents through the shared E2E pipeline, verify server-side with HMAC evidence, poll, park, remediate, and report.",
  "supports-headless": true,
  "phase-name": "2-build",
  "after": ["fetch-tests"],
  "before": ["update-status"],
  "is-required": false,
  "output-location": "{TEST_CODE_DIR}",
  "output-contract": {
    "frozen": false,
    "depended-on-by": ["update-status", "test-report"],
    "structure": {
      "root": "{project-root}/_bmad-output/test-artifacts/backfill/",
      "files": [
        "backfill-report-{YYYY-MM-DD-HHmm}.md"
      ],
      "loop-state": {
        "root": "{project-root}/_bmad-output/test-artifacts/backfill/",
        "files": [
          "heartbeat",
          "seen-history.json",
          "parked-tasks.json"
        ],
        "note": "Owned by scripts/backfill-state.py; persists across session restarts. heartbeat is removed at the end of stage 4; the JSON files survive for the next run's reconciliation."
      },
      "test-output": {
        "root": "{TEST_CODE_DIR}/",
        "files": [
          "tests/*.spec.ts",
          "pages/*.ts"
        ]
      },
      "knowledge-output": {
        "root": "{output_folder}/test-knowledge/",
        "files": [
          "*.md",
          ".manifest.jsonl"
        ]
      }
    }
  }
}
