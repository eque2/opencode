      "Bash(tail *integrity-key.json*)",
      "Bash(less *integrity-key.json*)",
      "Bash(more *integrity-key.json*)",
      "Bash(xxd *integrity-key.json*)",
      "Bash(grep *integrity-key.json*)",
      "Bash(od *integrity-key.json*)",
      "Bash(python3 *integrity-key.json*)",
      "Bash(python *integrity-key.json*)",
      "Bash(node *integrity-key.json*)",
      "Bash(perl *integrity-key.json*)",
      "Bash(ruby *integrity-key.json*)",
      "Bash(base64 *integrity-key.json*)",
      "Bash(strings *integrity-key.json*)",
      "Bash(hexdump *integrity-key.json*)",
      "Bash(file *integrity-key.json*)",
      "Read(.signer-key)",
      "Read(**/.signer-key)",
      "Bash(cat:.signer-key*)",
      "Bash(head:.signer-key*)",
      "Bash(tail:.signer-key*)",
      "Bash(less:.signer-key*)",
      "Bash(more:.signer-key*)",
      "Bash(xxd:.signer-key*)",
      "Bash(grep:.signer-key*)",
      "Bash(od:.signer-key*)",
      "Bash(python3:.signer-key*)",
      "Bash(python:.signer-key*)",
      "Bash(node:.signer-key*)",
      "Bash(perl:.signer-key*)",
      "Bash(ruby:.signer-key*)",
      "Bash(base64:.signer-key*)",
      "Bash(strings:.signer-key*)",
      "Bash(hexdump:.signer-key*)",
      "Bash(file:.signer-key*)",
      "Read(.evidence-key)",
      "Read(**/.evidence-key)",
      "Bash(cat:.evidence-key*)",
      "Bash(head:.evidence-key*)",
      "Bash(tail:.evidence-key*)",
      "Bash(less:.evidence-key*)",
      "Bash(more:.evidence-key*)",
      "Bash(xxd:.evidence-key*)",
      "Bash(grep:.evidence-key*)",
      "Bash(od:.evidence-key*)",
      "Bash(python3:.evidence-key*)",
      "Bash(python:.evidence-key*)",
      "Bash(node:.evidence-key*)",
      "Bash(perl:.evidence-key*)",
      "Bash(ruby:.evidence-key*)",
      "Bash(base64:.evidence-key*)",
      "Bash(strings:.evidence-key*)",
      "Bash(hexdump:.evidence-key*)",
      "Bash(file:.evidence-key*)",
      "Edit(evidence/*.json)",
      "Edit(**/evidence/*.json)",
      "Bash(cross-keychain:get*eque2-code-integrity*)",
      "Bash(security:find-generic-password*eque2-code-integrity*)",
      "Bash(secret-tool:lookup*eque2-code-integrity*)",
      "Bash(cross-keychain:get*eque2-code-signer*)",
      "Bash(security:find-generic-password*eque2-code-signer*)",
      "Bash(secret-tool:lookup*eque2-code-signer*)",
      "Edit(**/state/events.jsonl)",
      "Edit(**/state/HEAD.json)",
      "Edit(**/skills/eque2-code-setup/scripts/*.mjs)",
      "Edit(**/skills/eque2-code-setup/scripts/*.py)",
      "Edit(.claude/skills/eque2-code-setup/scripts/*.mjs)",
      "Edit(.claude/skills/eque2-code-setup/scripts/*.py)",
      "Edit(.agents/skills/eque2-code-setup/scripts/*.mjs)",
      "Edit(.agents/skills/eque2-code-setup/scripts/*.py)",
      "Edit(**/skills/eque2-code-goal-gate/*.sh)",
      "Edit(.claude/skills/eque2-code-goal-gate/*.sh)",
      "Edit(.agents/skills/eque2-code-goal-gate/*.sh)",
      "Edit(**/goal-gate/gate/goal-gate-stop.sh)",
      "Edit(**/goal-gate-runtime/gate/goal-gate-stop.sh)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/skills/eque2-code-goal-gate/goal-gate-stop.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "eque2-verifier",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/eque2-code-setup/scripts/verifier-marker-hook.py\" start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "eque2-verifier",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/eque2-code-setup/scripts/verifier-marker-hook.py\" stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/eque2-code-setup/scripts/mint-guard-hook.py\" --mode=session"
          }
        ]
      }
    ]
  }
}
